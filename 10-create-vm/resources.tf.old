
# 1. Create a Resource Group
resource "azurerm_resource_group" "rg" {
  name     = var.resource_group_name
  location = var.location
}

# 2. Create networking resources (VNet, Subnet, NIC)
module "network" {
  source = "../modules/network"

  resource_group_name    = azurerm_resource_group.rg.name
  location               = azurerm_resource_group.rg.location
  virtual_network_name   = var.virtual_network_name
  subnet_name            = var.subnet_name
  network_interface_name = var.network_interface_name
}

# 3. Create the Linux Virtual Machine
module "linux_vm" {
  source = "../modules/linux-vm"

  resource_group_name   = azurerm_resource_group.rg.name
  location              = azurerm_resource_group.rg.location
  vm_name               = var.linux_virtual_machine_name
  admin_username        = var.admin_username
  admin_password        = local.effective_linux_admin_password
  network_interface_ids = [module.network.network_interface_id]
}
